# ==============================================================================
# DOPHY MONOREPO - MASTER ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env in root or into individual app directories as needed.
# All values are intentionally left blank for security.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Main BaaS - Database & Authentication)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous API Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-SIDE ONLY, NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 2. CLOUDINARY CONFIGURATION (Cloud Storage for receipts, products, banners)
# ------------------------------------------------------------------------------
# Cloudinary Cloud Name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary Unsigned Upload Preset name (for direct client uploads)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Cloudinary API Key (Server-side)
CLOUDINARY_API_KEY=

# Cloudinary API Secret (Server-side, NEVER EXPOSE TO BROWSER)
CLOUDINARY_API_SECRET=


# ------------------------------------------------------------------------------
# 3. CLOUDFLARE WORKERS & OPENNEXT CONFIGURATION
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Found in Cloudflare Dashboard sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (with Workers/Pages edit permissions for deployments)
CLOUDFLARE_API_TOKEN=


# ------------------------------------------------------------------------------
# 4. APPLICATION URLS & BRANDING CONFIGURATION
# ------------------------------------------------------------------------------
# Main Affiliate App URL (e.g. https://app.dophy.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Public Bio-Link / Linktree App URL (e.g. https://link.dophy.com or http://localhost:3001)
NEXT_PUBLIC_LINK_PUBLIC_URL=

# Default Prefix for generated referral codes (e.g. DOPHY- -> DOPHY-RNDM123)
NEXT_PUBLIC_DEFAULT_REFERRAL_PREFIX=DOPHY-
