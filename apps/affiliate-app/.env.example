# ==============================================================================
# DOPHY AFFILIATE APP (Admin Dashboard & Affiliator Portal) - ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env or .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database & Authentication)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 2. CLOUDINARY (Cloud Storage for receipts, avatar, product images)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 3. APPLICATION & REFERRAL CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_REFERRAL_PREFIX=DOPHY-

# JWT / Auth Secret
AUTH_SECRET=

# Initial Admin Master Key
ADMIN_SETUP_KEY=
